file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
set(plans "${WORK_DIR}/plans")
function(discover features)
    execute_process(COMMAND "${TEST_EXECUTABLE}" --gtest_list_tests
        "feature_dir=${features}" "manifest_dir=${plans}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Discovery failed: ${out}${err}")
    endif()
endfunction()
function(count_plans count)
    file(GLOB files "${plans}/*.json")
    list(LENGTH files actual)
    if(NOT actual EQUAL count)
        message(FATAL_ERROR "Expected ${count} plans, found ${actual}: ${files}")
    endif()
endfunction()
discover("${SOURCE_DIR}/features")
if(CASE STREQUAL startup)
    # Registration must use the compact location index, without parsing plans.
    file(GLOB files "${plans}/*.json")
    foreach(path IN LISTS files)
        file(WRITE "${path}" "invalid plan JSON")
    endforeach()
    file(MAKE_DIRECTORY "${WORK_DIR}/report")
    file(WRITE "${WORK_DIR}/report/rules.json" "invalid report JSON")
    file(WRITE "${WORK_DIR}/report/runtime.index" "invalid metadata JSON")
    execute_process(COMMAND "${TEST_EXECUTABLE}" --gtest_filter=NoMatchingTests.*
        "manifest_dir=${plans}" "--rule-coverage-report=${WORK_DIR}/report"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0 OR NOT out MATCHES "0 tests")
        message(FATAL_ERROR "Unmatched tests must not load plans or reports: ${out}${err}")
    endif()
elseif(CASE STREQUAL collisions)
    count_plans(3)
    file(GLOB files "${plans}/*.json")
    set(values)
    foreach(path IN LISTS files)
        file(READ "${path}" json)
        string(JSON value GET "${json}" steps 0 captures 0 value)
        list(APPEND values ${value})
    endforeach()
    list(SORT values)
    if(NOT values STREQUAL "1;2;3")
        message(FATAL_ERROR "Collision discarded a scenario: ${values}")
    endif()
    execute_process(COMMAND "${TEST_EXECUTABLE}" --gtest_filter=ExecutionPlans.* "manifest_dir=${plans}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0 OR NOT out MATCHES "3 tests.*3 test suites|3 tests from 1 test suite")
        message(FATAL_ERROR "All colliding scenarios must execute: ${out}${err}")
    endif()
elseif(CASE STREQUAL warnings)
    file(MAKE_DIRECTORY "${WORK_DIR}/empty")
    execute_process(COMMAND "${TEST_EXECUTABLE}" --gtest_list_tests
        "feature_dir=${WORK_DIR}/empty" "manifest_dir=${plans}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    string(REGEX REPLACE "[ \t\r\n]+" " " normalized "${err}")
    if(NOT result EQUAL 0 OR
       NOT normalized MATCHES "manifest.yaml:2:5: warning: step definition" OR
       NOT normalized MATCHES "is never used by a discovered scenario")
        message(FATAL_ERROR "Unused definitions must warn without failing discovery: ${out}${err}")
    endif()
    count_plans(0)
elseif(CASE STREQUAL locations)
    # Exercise both discovery and normal execution, with spaces in output paths.
    foreach(mode IN ITEMS discovery execution legacy)
        set(report "${WORK_DIR}/${mode} report.json")
        set(extra_args)
        if(mode STREQUAL legacy)
            file(REMOVE "${plans}/locations.index")
        endif()
        if(mode STREQUAL discovery)
            list(APPEND extra_args --gtest_list_tests "feature_dir=${SOURCE_DIR}/features")
        endif()
        execute_process(COMMAND "${TEST_EXECUTABLE}" ${extra_args}
            "--gtest_output=json:${report}" --gtest_filter=ExecutionPlans.* "manifest_dir=${plans}"
            RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Report generation failed: ${out}${err}")
        endif()
        file(READ "${report}" json)
        string(JSON suite_count LENGTH "${json}" testsuites)
        math(EXPR last_suite "${suite_count} - 1")
        set(scenario_suite -1)
        foreach(suite RANGE 0 ${last_suite})
            string(JSON name GET "${json}" testsuites ${suite} name)
            if(name STREQUAL ExecutionPlans)
                set(scenario_suite ${suite})
            endif()
        endforeach()
        if(scenario_suite EQUAL -1)
            message(FATAL_ERROR "Scenario suite missing: ${json}")
        endif()
        string(JSON count LENGTH "${json}" testsuites ${scenario_suite} testsuite)
        if(NOT count EQUAL 3)
            message(FATAL_ERROR "Expected three reported scenarios: ${json}")
        endif()
        set(lines)
        foreach(index RANGE 0 2)
            string(JSON source GET "${json}" testsuites ${scenario_suite} testsuite ${index} file)
            string(JSON line GET "${json}" testsuites ${scenario_suite} testsuite ${index} line)
            file(TO_CMAKE_PATH "${source}" source)
            if(NOT source STREQUAL "${SOURCE_DIR}/features/Plans.feature")
                message(FATAL_ERROR "Wrong scenario source: ${source}")
            endif()
            list(APPEND lines "${line}")
        endforeach()
        list(SORT lines)
        if(NOT lines STREQUAL "2;4;6")
            message(FATAL_ERROR "Wrong scenario declaration lines: ${lines}")
        endif()
    endforeach()
elseif(CASE STREQUAL stale)
    file(WRITE "${plans}/keep.txt" "unrelated file")
    discover("${SOURCE_DIR}/reduced")
    count_plans(1)
    file(MAKE_DIRECTORY "${WORK_DIR}/empty")
    discover("${WORK_DIR}/empty")
    count_plans(0)
    if(NOT EXISTS "${plans}/keep.txt")
        message(FATAL_ERROR "Discovery removed an unrelated file")
    endif()
elseif(CASE STREQUAL dispatch)
    file(GLOB files "${plans}/*.json")
    list(GET files 0 path)
    file(READ "${path}" json)
    string(JSON json SET "${json}" steps 0 methodName "\"unknown_method\"")
    file(WRITE "${path}" "${json}")
    execute_process(COMMAND "${TEST_EXECUTABLE}" --gtest_filter=ExecutionPlans.* "manifest_dir=${plans}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(result EQUAL 0 OR NOT "${out}${err}" MATCHES "no step method named 'unknown_method'")
        message(FATAL_ERROR "Invalid dispatch must fail explicitly: ${out}${err}")
    endif()
elseif(CASE MATCHES "^(filesystem|writes|listing)$")
    if(CASE STREQUAL filesystem)
    file(WRITE "${WORK_DIR}/not-directory" "file")
    execute_process(COMMAND "${TEST_EXECUTABLE}" --gtest_list_tests
        "feature_dir=${SOURCE_DIR}/features" "manifest_dir=${WORK_DIR}/not-directory"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(result EQUAL 0 OR NOT err MATCHES "cannot create manifest directory")
        message(FATAL_ERROR "Directory creation must report its failure: ${out}${err}")
    endif()
    endif()
    if(UNIX AND CASE STREQUAL writes)
        find_program(BASH_EXECUTABLE bash REQUIRED)
        execute_process(COMMAND "${BASH_EXECUTABLE}" -c
            "trap '' XFSZ; ulimit -f 0; exec \"$@\"" --
            "${TEST_EXECUTABLE}" --gtest_list_tests
            "feature_dir=${SOURCE_DIR}/reduced" "manifest_dir=${plans}"
            RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(result EQUAL 0 OR NOT err MATCHES "cannot write zucchini manifest")
            message(FATAL_ERROR "Failed writes must be diagnosed: ${out}${err}")
        endif()
        count_plans(3)
        execute_process(COMMAND "${TEST_EXECUTABLE}" --gtest_filter=ExecutionPlans.* "manifest_dir=${plans}"
            RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Failed writes damaged previous plans: ${out}${err}")
        endif()
    endif()
    if(UNIX AND CASE STREQUAL listing)
        file(CREATE_LINK "${WORK_DIR}/missing" "${plans}/broken.json" SYMBOLIC RESULT link_error)
        if(NOT link_error STREQUAL "0")
            message(FATAL_ERROR "Cannot create broken-link fixture: ${link_error}")
        endif()
        execute_process(COMMAND "${TEST_EXECUTABLE}" --gtest_list_tests "manifest_dir=${plans}"
            RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(result EQUAL 0 OR NOT err MATCHES "cannot inspect manifest entry")
            message(FATAL_ERROR "Listing errors must be diagnosed: ${out}${err}")
        endif()
    endif()
endif()
