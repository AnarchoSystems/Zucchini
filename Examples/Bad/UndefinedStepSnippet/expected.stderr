undefined steps in 'features'; add these step definitions:

types:
  - name: IAddTheFollowingItemsRow
    kind: struct
    fields:
      - name: name
      - name: unitPrice
        type: float
        header: "unit price"
      - name: quantity
        type: int
      - name: inStock
        type: bool
        header: "in stock"
      - name: discount
        type: int
        optional: true

steps:
  - step: ^I add the following items:$
    methodName: i_add_the_following_items
    dataTable:
      type: IAddTheFollowingItemsRow
  - step: ^the cart total is (-?\d+\.\d+)$
    methodName: the_cart_total_is
    arguments:
      - name: arg1
        type: float
  - step: ^the receipt contains "([^"]*)"$
    methodName: the_receipt_contains
    arguments:
      - name: arg1
        type: string

