# Expand only the machine-dependent URL; all diagnostic wording stays literal.
function(manifest_review_url output path)
    get_filename_component(absolute "${path}" ABSOLUTE)
    file(TO_CMAKE_PATH "${absolute}" absolute)
    if(NOT absolute MATCHES "^/")
        set(absolute "/${absolute}")
    endif()
    set(url "vscode://file")
    string(LENGTH "${absolute}" length)
    math(EXPR last "${length} - 1")
    foreach(index RANGE 0 ${last})
        string(SUBSTRING "${absolute}" ${index} 1 byte)
        if(byte MATCHES "^[A-Za-z0-9/:._~-]$")
            string(APPEND url "${byte}")
        else()
            string(HEX "${byte}" hex)
            string(TOUPPER "${hex}" hex)
            string(APPEND url "%${hex}")
        endif()
    endforeach()
    set(${output} "${url}:1:1" PARENT_SCOPE)
endfunction()
