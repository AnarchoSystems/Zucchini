{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/AnarchoSystems/Zucchini/schemas/stylesheet.schema.json",
    "title": "Zucchini stylesheet",
    "description": "Optional code-generation conventions for Zucchini. Omitted settings use the built-in defaults.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "stringClass": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
                "name": {"type": "string"},
                "cStrMethod": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                    "default": "c_str"
                }
            },
            "description": "C++ string class and its const char* accessor."
        },
        "commonIncludes": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Headers included before generated Zucchini headers."
        },
        "cppConventions": {
            "type": "object",
            "additionalProperties": false,
            "description": "Rules for composing generated C++ type, method, and variable names.",
            "properties": {
                "types": {
                    "$ref": "#/definitions/typeNamingRule",
                    "description": "Naming rule for generated structs, enums, and fixture/interface classes."
                },
                "methods": {
                    "$ref": "#/definitions/methodNamingRule",
                    "description": "Naming rule for generated step-definition and hook methods."
                },
                "variables": {
                    "$ref": "#/definitions/variableNamingRule",
                    "description": "Naming rule for generated fields, step arguments, and generated map members."
                }
            }
        }
    },
    "definitions": {
        "casing": {
            "description": "snake_case uses underscores, camelCase starts lowercase, and PascalCase starts uppercase.",
            "enum": [
                "snake_case",
                "camelCase",
                "PascalCase"
            ]
        },
        "identifier": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "typeNamingBlock": {
            "description": "A type block selects a prefix or literal by generated type category. One block may define values for structs, enums, and generated fixture/interface classes.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "blockName"
            ],
            "properties": {
                "blockName": {
                    "$ref": "#/definitions/identifier",
                    "description": "Name used to reference this block from nameIt."
                },
                "default": {
                    "type": "string",
                    "description": "Value used when no active type condition matches. Defaults to empty."
                },
                "onStruct": {
                    "type": "string",
                    "description": "Value for generated struct types."
                },
                "onEnum": {
                    "type": "string",
                    "description": "Value for generated enum types."
                },
                "onClass": {
                    "type": "string",
                    "description": "Value for generated fixture and interface wrapper classes."
                },
                "onArgsType": {
                    "type": "string",
                    "description": "Value for generated per-step argument structs, whose base name is the operation id followed by Args."
                }
            },
            "anyOf": [
                {
                    "required": ["onStruct"]
                },
                {
                    "required": ["onEnum"]
                },
                {
                    "required": ["onClass"]
                },
                {
                    "required": ["onArgsType"]
                }
            ]
        },
        "typeNamingRule": {
            "type": "object",
            "additionalProperties": false,
            "description": "Blocks are optional. nameIt is an ordered list of block names, literals, and typeName.",
            "properties": {
                "casing": {"$ref": "#/definitions/casing"},
                "blocks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/typeNamingBlock"
                    }
                },
                "nameIt": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "methodNamingRule": {
            "type": "object",
            "additionalProperties": false,
            "description": "Blocks select values for step-definition or hook methods. nameIt is an ordered list of block names, literals, and methodName.",
            "properties": {
                "casing": {"$ref": "#/definitions/casing"},
                "blocks": {
                    "type": "array",
                    "items": {"$ref": "#/definitions/methodNamingBlock"}
                },
                "nameIt": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "methodNamingBlock": {
            "description": "A method block selects a prefix or literal for step definitions or hooks.",
            "type": "object",
            "additionalProperties": false,
            "required": ["blockName"],
            "properties": {
                "blockName": {"$ref": "#/definitions/identifier"},
                "default": {"type": "string"},
                "onStepDefinition": {"type": "string"},
                "onHook": {"type": "string"}
            },
            "anyOf": [
                {"required": ["onStepDefinition"]},
                {"required": ["onHook"]}
            ]
        },
        "variableNamingBlock": {
            "description": "A variable block must contain at least one condition, and all its conditions must come from one switch: kind, member, array, optional, map key type, or map value type.",
            "type": "object",
            "additionalProperties": false,
            "required": ["blockName"],
            "properties": {
                "blockName": {"$ref": "#/definitions/identifier"},
                "default": {"type": "string"},
                "onStruct": {"type": "string"},
                "onEnum": {"type": "string"},
                "onInt": {"type": "string"},
                "onDouble": {"type": "string"},
                "onBool": {"type": "string"},
                "onString": {"type": "string"},
                "onMember": {"type": "string"},
                "onNotMember": {"type": "string"},
                "onMap": {"type": "string"},
                "onNotMap": {"type": "string"},
                "onArray": {"type": "string"},
                "onNotArray": {"type": "string"},
                "onOptional": {"type": "string"},
                "onMandatory": {"type": "string"},
                "onMapKeyType": {
                    "$ref": "#/definitions/identifier",
                    "description": "Name of a kind-based variable block to evaluate for the map key type."
                },
                "onMapValueType": {
                    "$ref": "#/definitions/identifier",
                    "description": "Name of a kind-based variable block to evaluate for the map value type."
                }
            },
            "oneOf": [
                {
                    "anyOf": [
                        {"required": ["onStruct"]},
                        {"required": ["onEnum"]},
                        {"required": ["onInt"]},
                        {"required": ["onDouble"]},
                        {"required": ["onBool"]},
                        {"required": ["onString"]}
                    ],
                    "not": {
                        "anyOf": [
                            {"required": ["onMember"]},
                            {"required": ["onNotMember"]},
                            {"required": ["onArray"]},
                            {"required": ["onNotArray"]},
                            {"required": ["onOptional"]},
                            {"required": ["onMandatory"]},
                            {"required": ["onMapKeyType"]},
                            {"required": ["onMapValueType"]},
                            {"required": ["onMap"]},
                            {"required": ["onNotMap"]}
                        ]
                    }
                },
                {
                    "anyOf": [
                        {"required": ["onMember"]},
                        {"required": ["onNotMember"]}
                    ],
                    "not": {
                        "anyOf": [
                            {"required": ["onStruct"]},
                            {"required": ["onEnum"]},
                            {"required": ["onInt"]},
                            {"required": ["onDouble"]},
                            {"required": ["onBool"]},
                            {"required": ["onString"]},
                            {"required": ["onArray"]},
                            {"required": ["onNotArray"]},
                            {"required": ["onOptional"]},
                            {"required": ["onMandatory"]},
                            {"required": ["onMapKeyType"]},
                            {"required": ["onMapValueType"]},
                            {"required": ["onMap"]},
                            {"required": ["onNotMap"]}
                        ]
                    }
                },
                {
                    "anyOf": [
                        {"required": ["onArray"]},
                        {"required": ["onNotArray"]}
                    ],
                    "not": {
                        "anyOf": [
                            {"required": ["onStruct"]},
                            {"required": ["onEnum"]},
                            {"required": ["onInt"]},
                            {"required": ["onDouble"]},
                            {"required": ["onBool"]},
                            {"required": ["onString"]},
                            {"required": ["onMember"]},
                            {"required": ["onNotMember"]},
                            {"required": ["onOptional"]},
                            {"required": ["onMandatory"]},
                            {"required": ["onMapKeyType"]},
                            {"required": ["onMapValueType"]},
                            {"required": ["onMap"]},
                            {"required": ["onNotMap"]}
                        ]
                    }
                },
                {
                    "anyOf": [
                        {"required": ["onOptional"]},
                        {"required": ["onMandatory"]}
                    ],
                    "not": {
                        "anyOf": [
                            {"required": ["onStruct"]},
                            {"required": ["onEnum"]},
                            {"required": ["onInt"]},
                            {"required": ["onDouble"]},
                            {"required": ["onBool"]},
                            {"required": ["onString"]},
                            {"required": ["onMember"]},
                            {"required": ["onNotMember"]},
                            {"required": ["onArray"]},
                            {"required": ["onNotArray"]},
                            {"required": ["onMapKeyType"]},
                            {"required": ["onMapValueType"]},
                            {"required": ["onMap"]},
                            {"required": ["onNotMap"]}
                        ]
                    }
                },
                {
                    "required": ["onMapKeyType"],
                    "not": {
                        "anyOf": [
                            {"required": ["onStruct"]},
                            {"required": ["onEnum"]},
                            {"required": ["onInt"]},
                            {"required": ["onDouble"]},
                            {"required": ["onBool"]},
                            {"required": ["onString"]},
                            {"required": ["onMember"]},
                            {"required": ["onNotMember"]},
                            {"required": ["onArray"]},
                            {"required": ["onNotArray"]},
                            {"required": ["onOptional"]},
                            {"required": ["onMandatory"]},
                            {"required": ["onMapValueType"]},
                            {"required": ["onMap"]},
                            {"required": ["onNotMap"]}
                        ]
                    }
                },
                {
                    "required": ["onMapValueType"],
                    "not": {
                        "anyOf": [
                            {"required": ["onStruct"]},
                            {"required": ["onEnum"]},
                            {"required": ["onInt"]},
                            {"required": ["onDouble"]},
                            {"required": ["onBool"]},
                            {"required": ["onString"]},
                            {"required": ["onMember"]},
                            {"required": ["onNotMember"]},
                            {"required": ["onArray"]},
                            {"required": ["onNotArray"]},
                            {"required": ["onOptional"]},
                            {"required": ["onMandatory"]},
                            {"required": ["onMapKeyType"]},
                            {"required": ["onMap"]},
                            {"required": ["onNotMap"]}
                        ]
                    }
                },
                {
                    "anyOf": [
                        {"required": ["onMap"]},
                        {"required": ["onNotMap"]}
                    ],
                    "not": {
                        "anyOf": [
                            {"required": ["onStruct"]},
                            {"required": ["onEnum"]},
                            {"required": ["onInt"]},
                            {"required": ["onDouble"]},
                            {"required": ["onBool"]},
                            {"required": ["onString"]},
                            {"required": ["onMember"]},
                            {"required": ["onNotMember"]},
                            {"required": ["onArray"]},
                            {"required": ["onNotArray"]},
                            {"required": ["onOptional"]},
                            {"required": ["onMandatory"]},
                            {"required": ["onMapKeyType"]},
                            {"required": ["onMapValueType"]}
                        ]
                    }
                }
            ]
        },
        "variableNamingRule": {
            "type": "object",
            "additionalProperties": false,
            "description": "Blocks are optional. nameIt is an ordered list of block names, literals, and variableName.",
            "properties": {
                "casing": {"$ref": "#/definitions/casing"},
                "mapBaseNameIsSingular": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use singular additionalProperty as the generated map member stem before casing is applied."
                },
                "blocks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/variableNamingBlock"
                    }
                },
                "nameIt": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
