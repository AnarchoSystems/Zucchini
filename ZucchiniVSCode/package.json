{
  "name": "zucchini-rules",
  "displayName": "Zucchini Rules",
  "description": "Explore fixture rules, their witnessing scenarios, and coverage gaps.",
  "version": "0.4.0",
  "publisher": "AnarchoSystems",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "workspaceContains:**/rules.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Browsing is available; execution and AI require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test Test/*.test.js",
    "check": "node --check src/extension.js && node --check src/model.js && node --check src/context.js && node --check src/runner.js && node --check src/features.js && node --check src/results.js && node --check src/generation.js && node --check src/sources.js && node --check src/hunt.js && node --check src/statisticsView.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zucchini",
          "title": "Zucchini",
          "icon": "media/zucchini.png"
        }
      ]
    },
    "views": {
      "zucchini": [
        {
          "id": "zucchini.rules",
          "name": "Fixture",
          "icon": "media/zucchini.png",
          "when": "config.zucchini.grouping != statistics"
        },
        {
          "type": "webview",
          "id": "zucchini.statistics",
          "name": "Statistics",
          "icon": "media/zucchini.png",
          "when": "config.zucchini.grouping == statistics"
        }
      ]
    },
    "commands": [
      {
        "command": "zucchini.refresh",
        "title": "Zucchini: Refresh Reports",
        "icon": "$(refresh)"
      },
      {
        "command": "zucchini.selectFixture",
        "title": "Zucchini: Select Fixture",
        "icon": "$(package)"
      },
      {
        "command": "zucchini.group",
        "title": "Zucchini: Change Grouping",
        "icon": "$(list-tree)"
      },
      {
        "command": "zucchini.run",
        "title": "Zucchini: Run Scenarios",
        "icon": "$(play)"
      },
      {
        "command": "zucchini.open",
        "title": "Zucchini: Open Scenario",
        "icon": "$(go-to-file)"
      },
      {
        "command": "zucchini.generate",
        "title": "Zucchini: Generate Scenarios",
        "icon": "$(sparkle)"
      },
      {
        "command": "zucchini.examples",
        "title": "Zucchini: Generate Passing Scenarios",
        "icon": "$(sparkle)"
      },
      {
        "command": "zucchini.counterexamples",
        "title": "Zucchini: Generate Failing Scenarios",
        "icon": "$(beaker)"
      },
      {
        "command": "zucchini.showScenarios",
        "title": "Scenarios",
        "category": "Zucchini"
      },
      {
        "command": "zucchini.showScenarios.checked",
        "title": "✓ Scenarios",
        "category": "Zucchini"
      },
      {
        "command": "zucchini.showRules",
        "title": "Rules",
        "category": "Zucchini"
      },
      {
        "command": "zucchini.showRules.checked",
        "title": "✓ Rules",
        "category": "Zucchini"
      },
      {
        "command": "zucchini.showStatistics",
        "title": "Statistics",
        "category": "Zucchini"
      },
      {
        "command": "zucchini.showStatistics.checked",
        "title": "✓ Statistics",
        "category": "Zucchini"
      },
      {
        "command": "zucchini.find",
        "title": "Zucchini: Find / Filter Tree",
        "icon": "$(filter)"
      },
      {
        "command": "zucchini.exploratory",
        "title": "Zucchini: Generate Exploratory Scenarios",
        "icon": "$(compass)"
      },
      {
        "command": "zucchini.findViolations",
        "title": "Zucchini: Find Failing Scenarios for All Obligations",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zucchini.refresh",
          "when": "view =~ /^zucchini\\.(rules|statistics)$/",
          "group": "navigation"
        },
        {
          "command": "zucchini.selectFixture",
          "when": "view =~ /^zucchini\\.(rules|statistics)$/",
          "group": "navigation@1"
        },
        {
          "submenu": "zucchini.view",
          "when": "view =~ /^zucchini\\.(rules|statistics)$/",
          "group": "navigation@2"
        },
        {
          "command": "zucchini.find",
          "when": "view == zucchini.rules",
          "group": "navigation@3"
        },
        {
          "command": "zucchini.run",
          "when": "view == zucchini.rules && isWorkspaceTrusted",
          "group": "navigation@4"
        },
        {
          "command": "zucchini.findViolations",
          "when": "view == zucchini.rules && isWorkspaceTrusted",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "zucchini.run",
          "when": "view == zucchini.rules && viewItem =~ /^(rule|requirement|unassigned|feature|gherkinRule|scenario|line)$/ && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "zucchini.generate",
          "when": "view == zucchini.rules && viewItem =~ /^(rule|requirement)$/ && isWorkspaceTrusted",
          "group": "inline@2"
        },
        {
          "command": "zucchini.examples",
          "when": "view == zucchini.rules && viewItem =~ /^(rule|requirement)$/ && isWorkspaceTrusted",
          "group": "generation@0"
        },
        {
          "command": "zucchini.counterexamples",
          "when": "view == zucchini.rules && viewItem =~ /^(rule|requirement)$/ && isWorkspaceTrusted",
          "group": "generation@1"
        },
        {
          "command": "zucchini.exploratory",
          "when": "view == zucchini.rules && viewItem =~ /^(rule|requirement)$/ && isWorkspaceTrusted",
          "group": "generation@2"
        },
        {
          "command": "zucchini.findViolations",
          "when": "view == zucchini.rules && viewItem == rule && isWorkspaceTrusted",
          "group": "generation@3"
        }
      ],
      "zucchini.view": [
        {
          "command": "zucchini.showRules",
          "when": "config.zucchini.grouping != rules",
          "group": "1_view@1"
        },
        {
          "command": "zucchini.showRules.checked",
          "when": "config.zucchini.grouping == rules",
          "group": "1_view@1"
        },
        {
          "command": "zucchini.showScenarios",
          "when": "config.zucchini.grouping != scenarios",
          "group": "1_view@2"
        },
        {
          "command": "zucchini.showScenarios.checked",
          "when": "config.zucchini.grouping == scenarios",
          "group": "1_view@2"
        },
        {
          "command": "zucchini.showStatistics",
          "when": "config.zucchini.grouping != statistics",
          "group": "1_view@3"
        },
        {
          "command": "zucchini.showStatistics.checked",
          "when": "config.zucchini.grouping == statistics",
          "group": "1_view@3"
        }
      ],
      "commandPalette": [
        {
          "command": "zucchini.showRules.checked",
          "when": "false"
        },
        {
          "command": "zucchini.showScenarios.checked",
          "when": "false"
        },
        {
          "command": "zucchini.showStatistics.checked",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Zucchini",
      "properties": {
        "zucchini.reportPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/zucchini-reports/**/rules.json"
          ],
          "description": "Workspace-relative report globs. Ignored build directories are searched."
        },
        "zucchini.grouping": {
          "type": "string",
          "enum": [
            "rules",
            "scenarios",
            "statistics"
          ],
          "default": "rules",
          "enumDescriptions": [
            "Business rules of the selected fixture, their obligations and scenarios.",
            "Every scenario of the selected fixture, expanding to its steps with rule observations or assertions not tied to a requirement.",
            "Advisory assertion statistics of the selected fixture: assertions not tied to a requirement, scenarios without assertions, and requirement strictness."
          ]
        },
        "zucchini.scenarioCount": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Number of scenarios requested from AI."
        },
        "zucchini.maxFailingScenarios": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 5,
          "description": "Maximum failing scenarios the model may propose for one fixture in Find Failing Scenarios for All Obligations, across all of the fixture's obligations. Applies to every iteration; each iteration is one model request, up to zucchini.maxGenerationAttempts. Independent of zucchini.scenarioCount. The model may propose none."
        },
        "zucchini.ctestPath": {
          "type": "string",
          "default": "ctest"
        },
        "zucchini.fixtures": {
          "type": "object",
          "default": {},
          "description": "Overrides keyed by fixture name or absolute report path. Set buildDirectory, buildTarget, configuration, manifest, and sourceFiles (absolute paths). sourceFiles adds implementation and rule context for AI.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "buildDirectory": {
                "type": "string"
              },
              "buildTarget": {
                "type": "string",
                "description": "CMake target to build for generation validation. Defaults to the report executable filename without .exe. Set this when OUTPUT_NAME differs from the target name or the report has no executable."
              },
              "configuration": {
                "type": "string"
              },
              "manifest": {
                "type": "string"
              },
              "sourceFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "zucchini.strictnessColors": {
          "type": "object",
          "default": {},
          "markdownDescription": "Background colors of requirement strictness badges in hovers, as `#rrggbb`. Unset levels use colors that suit the current theme. Text color follows the background's brightness.",
          "properties": {
            "exact": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "patternErrorMessage": "Use a hex color such as #cdebdc."
            },
            "one_of": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "patternErrorMessage": "Use a hex color such as #cdebdc."
            },
            "bounded": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "patternErrorMessage": "Use a hex color such as #cdebdc."
            },
            "open_ended": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "patternErrorMessage": "Use a hex color such as #cdebdc."
            },
            "unspecified": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "patternErrorMessage": "Use a hex color such as #cdebdc."
            }
          },
          "additionalProperties": false
        },
        "zucchini.maxGenerationAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 3,
          "description": "Maximum AI generation attempts, including revisions after building and running the new scenarios. Also the maximum iterations (one model request each) per fixture for Find Failing Scenarios for All Obligations."
        },
        "zucchini.sourceTools": {
          "type": "boolean",
          "default": true,
          "description": "Let the model list, search and read workspace files during scenario generation, so it can follow declarations into implementation sources. Requires a model that supports tool calling."
        },
        "zucchini.maxSourceToolCalls": {
          "type": "integer",
          "minimum": 1,
          "default": 40,
          "description": "Maximum source tool calls per generation attempt or failing-scenario iteration."
        },
        "zucchini.parallel": {
          "type": "boolean",
          "default": true,
          "description": "Run selected scenarios in parallel using CTest. Disable to force one worker, overriding zucchini.jobs."
        },
        "zucchini.jobs": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "CTest worker count. 0 uses all processors available to the extension host. Applies to scenario runs and generation validation."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "zucchini.rules",
        "contents": "Build a zucchinified fixture, then [refresh](command:zucchini.refresh).\nReports in ignored build directories are included. For custom locations set zucchini.reportPatterns."
      }
    ],
    "submenus": [
      {
        "id": "zucchini.view",
        "label": "View",
        "icon": "$(list-tree)"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnarchoSystems/Zucchini.git",
    "directory": "ZucchiniVSCode"
  },
  "icon": "media/icon.png",
  "zucchiniRuleReport": {
    "versionRange": ">=2.0.0 <3.0.0"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "semver": "^7.8.5"
  }
}
