{
  "name": "zucchini-rules",
  "displayName": "Zucchini Rules",
  "description": "Explore fixture rules, their witnessing scenarios, and coverage gaps.",
  "version": "0.2.0",
  "publisher": "AnarchoSystems",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "workspaceContains:**/rules.json"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Browsing is available; execution and AI require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test Test/*.test.js",
    "check": "node --check src/extension.js && node --check src/model.js && node --check src/context.js && node --check src/runner.js && node --check src/features.js && node --check src/results.js && node --check src/generation.js && node --check src/sources.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zucchini",
          "title": "Zucchini",
          "icon": "media/zucchini.png"
        }
      ]
    },
    "views": {
      "zucchini": [
        {
          "id": "zucchini.rules",
          "name": "Fixtures and Rules",
          "icon": "media/zucchini.png"
        }
      ]
    },
    "commands": [
      {
        "command": "zucchini.refresh",
        "title": "Zucchini: Refresh Reports",
        "icon": "$(refresh)"
      },
      {
        "command": "zucchini.group",
        "title": "Zucchini: Change Grouping",
        "icon": "$(list-tree)"
      },
      {
        "command": "zucchini.run",
        "title": "Zucchini: Run Scenarios",
        "icon": "$(play)"
      },
      {
        "command": "zucchini.open",
        "title": "Zucchini: Open Scenario",
        "icon": "$(go-to-file)"
      },
      {
        "command": "zucchini.generate",
        "title": "Zucchini: Generate Scenarios",
        "icon": "$(sparkle)"
      },
      {
        "command": "zucchini.examples",
        "title": "Zucchini: Generate Passing Scenarios",
        "icon": "$(sparkle)"
      },
      {
        "command": "zucchini.counterexamples",
        "title": "Zucchini: Generate Failing Scenarios",
        "icon": "$(beaker)"
      },
      {
        "command": "zucchini.showScenarios",
        "title": "Zucchini: Show Flat Scenarios",
        "icon": "$(list-flat)"
      },
      {
        "command": "zucchini.showRules",
        "title": "Zucchini: Show Rule Hierarchy",
        "icon": "$(list-tree)"
      },
      {
        "command": "zucchini.clearFixtureFilter",
        "title": "Zucchini: Clear Fixture Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "zucchini.find",
        "title": "Zucchini: Find / Filter Tree",
        "icon": "$(filter)"
      },
      {
        "command": "zucchini.exploratory",
        "title": "Zucchini: Generate Exploratory Scenarios",
        "icon": "$(compass)"
      },
      {
        "command": "zucchini.findViolations",
        "title": "Zucchini: Find Failing Scenarios for All Obligations",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zucchini.refresh",
          "when": "view == zucchini.rules",
          "group": "navigation"
        },
        {
          "command": "zucchini.showScenarios",
          "when": "view == zucchini.rules && config.zucchini.grouping != scenarios",
          "group": "navigation@2"
        },
        {
          "command": "zucchini.showRules",
          "when": "view == zucchini.rules && config.zucchini.grouping == scenarios",
          "group": "navigation@2"
        },
        {
          "command": "zucchini.find",
          "when": "view == zucchini.rules",
          "group": "navigation@3"
        },
        {
          "command": "zucchini.clearFixtureFilter",
          "when": "view == zucchini.rules && config.zucchini.fixtureFilter != ''",
          "group": "navigation@4"
        },
        {
          "command": "zucchini.findViolations",
          "when": "view == zucchini.rules && isWorkspaceTrusted",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "zucchini.run",
          "when": "view == zucchini.rules && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "zucchini.generate",
          "when": "view == zucchini.rules && viewItem =~ /^(rule|requirement)$/ && isWorkspaceTrusted",
          "group": "inline@2"
        },
        {
          "command": "zucchini.findViolations",
          "when": "view == zucchini.rules && viewItem == fixture && isWorkspaceTrusted",
          "group": "inline@2"
        },
        {
          "command": "zucchini.examples",
          "when": "view == zucchini.rules && viewItem =~ /^(rule|requirement)$/ && isWorkspaceTrusted",
          "group": "generation@0"
        },
        {
          "command": "zucchini.counterexamples",
          "when": "view == zucchini.rules && viewItem =~ /^(rule|requirement)$/ && isWorkspaceTrusted",
          "group": "generation@1"
        },
        {
          "command": "zucchini.exploratory",
          "when": "view == zucchini.rules && viewItem =~ /^(rule|requirement)$/ && isWorkspaceTrusted",
          "group": "generation@2"
        },
        {
          "command": "zucchini.findViolations",
          "when": "view == zucchini.rules && viewItem =~ /^(fixture|rule)$/ && isWorkspaceTrusted",
          "group": "generation@3"
        }
      ]
    },
    "configuration": {
      "title": "Zucchini",
      "properties": {
        "zucchini.reportPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/zucchini-reports/**/rules.json"
          ],
          "description": "Workspace-relative report globs. Ignored build directories are searched."
        },
        "zucchini.grouping": {
          "type": "string",
          "enum": [
            "rules",
            "scenarios"
          ],
          "default": "rules"
        },
        "zucchini.scenarioCount": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Number of scenarios requested from AI."
        },
        "zucchini.failingScenariosPerObligation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 1,
          "description": "Maximum failing scenarios requested per obligation by Find Failing Scenarios for All Obligations. Independent of zucchini.scenarioCount. The model may return none when it finds no violation."
        },
        "zucchini.sweepSurvey": {
          "type": "boolean",
          "default": true,
          "description": "Before Find Failing Scenarios for All Obligations dives into each obligation, survey each fixture once to map the implementation and rate how likely each obligation is violated. The survey also decides which obligations need a dive and allocates each dive's tool calls and attempts. Dives run most likely first, with the survey notes and files as context."
        },
        "zucchini.sweepSurveyMaySkip": {
          "type": "boolean",
          "default": true,
          "description": "Let the survey clear obligations it rates low, with cited evidence, so they get no dive. Disable to dive into every obligation; the survey still allocates tool calls and attempts."
        },
        "zucchini.sweepDiveSourceToolCalls": {
          "type": "integer",
          "minimum": 0,
          "default": 10,
          "description": "Most source tool calls per attempt the survey may allocate to one focused dive. The survey itself uses zucchini.maxSourceToolCalls. 0 makes every dive answer from the survey notes and inlined files only."
        },
        "zucchini.ctestPath": {
          "type": "string",
          "default": "ctest"
        },
        "zucchini.fixtures": {
          "type": "object",
          "default": {},
          "description": "Overrides keyed by fixture name or absolute report path. Set buildDirectory, buildTarget, configuration, manifest, and sourceFiles (absolute paths). sourceFiles adds implementation and rule context for AI.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "buildDirectory": {
                "type": "string"
              },
              "buildTarget": {
                "type": "string",
                "description": "CMake target to build for generation validation. Defaults to the report executable filename without .exe. Set this when OUTPUT_NAME differs from the target name or the report has no executable."
              },
              "configuration": {
                "type": "string"
              },
              "manifest": {
                "type": "string"
              },
              "sourceFiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "zucchini.fixtureFilter": {
          "type": "string",
          "default": "",
          "description": "Filter fixture names (case insensitive). Comma-separated includes, !excludes, * and ? wildcards. Plain text matches substrings; empty shows all fixtures."
        },
        "zucchini.maxGenerationAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 3,
          "description": "Maximum AI generation attempts, including revisions after building and running the new scenarios."
        },
        "zucchini.sourceTools": {
          "type": "boolean",
          "default": true,
          "description": "Let the model list, search and read workspace files during scenario generation, so it can follow declarations into implementation sources. Requires a model that supports tool calling."
        },
        "zucchini.maxSourceToolCalls": {
          "type": "integer",
          "minimum": 1,
          "default": 40,
          "description": "Maximum source tool calls per generation attempt."
        },
        "zucchini.parallel": {
          "type": "boolean",
          "default": true,
          "description": "Run selected scenarios in parallel using CTest. Disable to force one worker, overriding zucchini.jobs."
        },
        "zucchini.jobs": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "CTest worker count. 0 uses all processors available to the extension host. Applies to scenario runs and generation validation."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "zucchini.rules",
        "contents": "Build a fixture with RULE_COVERAGE_REPORT, then [refresh](command:zucchini.refresh).\nReports in ignored build directories are included. For custom locations set zucchini.reportPatterns."
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnarchoSystems/Zucchini.git",
    "directory": "ZucchiniVSCode"
  },
  "icon": "media/icon.png",
  "zucchiniRuleReport": {
    "versionRange": ">=2.0.0 <3.0.0"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "semver": "^7.8.5"
  }
}
