{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/AnarchoSystems/Zucchini/stylesheet.schema.json",
    "title": "Zucchini stylesheet",
    "description": "Optional code-generation conventions for Zucchini. Omitted settings use the built-in defaults.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "stringClass": {
            "type": "string",
            "description": "C++ type used for fields/arguments/docstrings declared as 'string'. Defaults to std::string. Must be constructible from std::string."
        },
        "hooks": {
            "type": "object",
            "additionalProperties": false,
            "description": "Casing of the two fixed interface hook methods. Defaults to snake_case for both.",
            "properties": {
                "aroundStep": {
                    "$ref": "#/definitions/casing",
                    "description": "Casing for the around-step hook. Defaults to snake_case."
                },
                "validateScenario": {
                    "$ref": "#/definitions/casing",
                    "description": "Casing for the scenario-validation hook. Defaults to snake_case."
                }
            }
        },
        "snippets": {
            "type": "object",
            "additionalProperties": false,
            "description": "Casing used when Zucchini prints ready-to-paste manifest fragments for undefined steps.",
            "properties": {
                "methods": {
                    "$ref": "#/definitions/casing",
                    "description": "Casing of suggested step methodNames. Defaults to snake_case."
                },
                "classes": {
                    "$ref": "#/definitions/casing",
                    "description": "Casing of suggested data table row type names. Defaults to CamelCase."
                }
            }
        },
        "cppConventions": {
            "type": "object",
            "additionalProperties": false,
            "description": "Rules for composing generated C++ type, method, and variable names.",
            "properties": {
                "types": {
                    "$ref": "#/definitions/typeNamingRule",
                    "description": "Naming rule for generated structs and enums."
                },
                "methods": {
                    "$ref": "#/definitions/methodNamingRule",
                    "description": "Naming rule for generated step methods."
                },
                "variables": {
                    "$ref": "#/definitions/variableNamingRule",
                    "description": "Naming rule for generated fields and step arguments."
                }
            }
        }
    },
    "definitions": {
        "casing": {
            "description": "snake_case uses underscores, camelCase starts lowercase, and CamelCase starts uppercase.",
            "enum": [
                "snake_case",
                "camelCase",
                "CamelCase"
            ]
        },
        "identifier": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "typeNamingBlock": {
            "description": "A type block selects a prefix or literal by type kind. Use onStruct and/or onEnum, but no other condition keys.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "blockName"
            ],
            "properties": {
                "blockName": {
                    "$ref": "#/definitions/identifier",
                    "description": "Name used to reference this block from nameIt."
                },
                "default": {
                    "type": "string",
                    "description": "Value used when no active type condition matches. Defaults to empty."
                },
                "onStruct": {
                    "type": "string",
                    "description": "Value for generated struct types."
                },
                "onEnum": {
                    "type": "string",
                    "description": "Value for generated enum types."
                }
            },
            "anyOf": [
                {
                    "required": ["onStruct"]
                },
                {
                    "required": ["onEnum"]
                }
            ]
        },
        "typeNamingRule": {
            "type": "object",
            "additionalProperties": false,
            "description": "Blocks are optional. nameIt is an ordered list of block names, literals, and typeName.",
            "properties": {
                "blocks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/typeNamingBlock"
                    }
                },
                "nameIt": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "methodNamingRule": {
            "type": "object",
            "additionalProperties": false,
            "description": "nameIt is an ordered list of literals and methodName. The default is [methodName].",
            "properties": {
                "nameIt": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "variableNamingBlock": {
            "description": "A variable block must contain at least one condition, and all its conditions must come from one switch: kind, member, list, or optional.",
            "type": "object",
            "additionalProperties": false,
            "required": ["blockName"],
            "properties": {
                "blockName": {"$ref": "#/definitions/identifier"},
                "default": {"type": "string"},
                "onStruct": {"type": "string"},
                "onEnum": {"type": "string"},
                "onInt": {"type": "string"},
                "onDouble": {"type": "string"},
                "onBool": {"type": "string"},
                "onString": {"type": "string"},
                "onMember": {"type": "string"},
                "onNotMember": {"type": "string"},
                "onArray": {"type": "string"},
                "onNotArray": {"type": "string"},
                "onOptional": {"type": "string"},
                "onMandatory": {"type": "string"}
            },
            "oneOf": [
                {
                    "anyOf": [
                        {"required": ["onStruct"]},
                        {"required": ["onEnum"]},
                        {"required": ["onInt"]},
                        {"required": ["onDouble"]},
                        {"required": ["onBool"]},
                        {"required": ["onString"]}
                    ],
                    "not": {
                        "anyOf": [
                            {"required": ["onMember"]},
                            {"required": ["onNotMember"]},
                            {"required": ["onArray"]},
                            {"required": ["onNotArray"]},
                            {"required": ["onOptional"]},
                            {"required": ["onMandatory"]}
                        ]
                    }
                },
                {
                    "anyOf": [
                        {"required": ["onMember"]},
                        {"required": ["onNotMember"]}
                    ],
                    "not": {
                        "anyOf": [
                            {"required": ["onStruct"]},
                            {"required": ["onEnum"]},
                            {"required": ["onInt"]},
                            {"required": ["onDouble"]},
                            {"required": ["onBool"]},
                            {"required": ["onString"]},
                            {"required": ["onArray"]},
                            {"required": ["onNotArray"]},
                            {"required": ["onOptional"]},
                            {"required": ["onMandatory"]}
                        ]
                    }
                },
                {
                    "anyOf": [
                        {"required": ["onArray"]},
                        {"required": ["onNotArray"]}
                    ],
                    "not": {
                        "anyOf": [
                            {"required": ["onStruct"]},
                            {"required": ["onEnum"]},
                            {"required": ["onInt"]},
                            {"required": ["onDouble"]},
                            {"required": ["onBool"]},
                            {"required": ["onString"]},
                            {"required": ["onMember"]},
                            {"required": ["onNotMember"]},
                            {"required": ["onOptional"]},
                            {"required": ["onMandatory"]}
                        ]
                    }
                },
                {
                    "anyOf": [
                        {"required": ["onOptional"]},
                        {"required": ["onMandatory"]}
                    ],
                    "not": {
                        "anyOf": [
                            {"required": ["onStruct"]},
                            {"required": ["onEnum"]},
                            {"required": ["onInt"]},
                            {"required": ["onDouble"]},
                            {"required": ["onBool"]},
                            {"required": ["onString"]},
                            {"required": ["onMember"]},
                            {"required": ["onNotMember"]},
                            {"required": ["onArray"]},
                            {"required": ["onNotArray"]}
                        ]
                    }
                }
            ]
        },
        "variableNamingRule": {
            "type": "object",
            "additionalProperties": false,
            "description": "Blocks are optional. nameIt is an ordered list of block names, literals, and variableName.",
            "properties": {
                "blocks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/variableNamingBlock"
                    }
                },
                "nameIt": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
